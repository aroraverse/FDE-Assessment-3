# Local mock service
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001

# LLM provider: Groq (Architecture A).
# Never commit a real key. Copy this file to .env and fill in your own value.
GROQ_API_KEY=
# Optional model override (defaults to llama-3.3-70b-versatile):
# GROQ_MODEL=llama-3.3-70b-versatile
# MODEL_NAME is also accepted as an alias for the model id.
# MODEL_NAME=llama-3.3-70b-versatile
# Optional custom endpoint:
# GROQ_BASE_URL=
